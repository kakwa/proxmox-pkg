#!/bin/sh
# pbuilder "D" hook: runs inside the build chroot right before satisfydepends.
#
# Problem 1 (stale index): pbuilder-satisfydepends never runs "apt-get
# update", so the chroot's apt index for the local file:// repository is a
# clone of the base cow's index, refreshed only by "cowbuilder --update".
# Packages built *earlier in the same pass* are linked into the repository
# after that refresh, so refresh only the local repo index here (offline).
#
# Problem 2 (dependency cycles between our own packages): e.g.
#   libproxmox-acme      (Build-Depends: libpve-common-perl)
#   libpve-common-perl   (Depends: libproxmox-acme-perl)
# aptitude's satisfydepends resolves the build-deps as a *runtime* install,
# so it refuses libpve-common-perl while libproxmox-acme-perl (the very
# package being built) is absent from the repository.
#
# Fix:
#   a) install a stub .deb for every binary package of the source being
#      built (with the real version), so apt can resolve the cycle;
#   b) apt-get-install the local-repo build-deps (this also pulls their
#      Debian deps and leaves a *consistent* dpkg state); packages whose
#      deps are not yet resolvable are skipped - the retry loop in the
#      root Makefile builds them in a later pass.
#
# NOTE: do NOT dpkg-install unrelated local packages (lxc-pve,
# librados2-perl, ...): their unresolvable deps (Ceph, not-yet-built
# packages) make aptitude's problem resolver report "Unable to resolve
# dependencies" even for builds that do not need them.
#
# The hook is best-effort: every step tolerates failure (warning only).
# The real gate is the satisfydepends step that runs afterwards.
export DEBIAN_FRONTEND=noninteractive

warn() { echo "D10update-local-repo: $*" >&2; }

# --- refresh the local file:// repository index ---
local_sources=$(mktemp /tmp/apt-local-sources.XXXXXX)
trap 'rm -f "$local_sources"' EXIT INT TERM

grep -h 'file://' /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null > "$local_sources" || true

repo_path=""
if [ -s "$local_sources" ]; then
    if ! apt-get -q update \
        -o Dir::Etc::sourcelist="$local_sources" \
        -o Dir::Etc::sourceparts="-" \
        -o APT::Get::List-Cleanup="0" 2>/dev/null; then
        warn "local repo apt-get update failed, continuing with the cloned index"
    fi
    repo_url=$(grep -o 'file://[^ ]*' "$local_sources" | head -n 1)
    [ -n "$repo_url" ] && repo_path=${repo_url#file://}
fi

# --- locate the extracted source's debian/ directory ---
# pbuilder extracts the source into /build before running the D hooks.
debian_dir=$(find /build -maxdepth 3 -type d -name debian 2>/dev/null | head -n 1)
if [ -z "$debian_dir" ] || [ ! -f "$debian_dir/control" ]; then
    warn "could not find the extracted debian/ directory, skipping local-dep prep"
    exit 0
fi
control_file=$debian_dir/control

# --- (a) stub every binary package of the source being built ---
src_version=$(head -n 1 "$debian_dir/changelog" 2>/dev/null | sed -n 's/^[^(]*(\([^)]*\)).*$/\1/p')
[ -n "$src_version" ] || src_version="9999.0"

install_stub() {
    _pkg=$1
    _dir="/tmp/stub-$$-$_pkg"
    rm -rf "$_dir"
    mkdir -p "$_dir/DEBIAN"
    {
        echo "Package: $_pkg"
        echo "Version: $src_version"
        echo "Architecture: all"
        echo "Maintainer: stub <stub@localhost>"
        echo "Description: stub for cycle-breaking during build"
        echo " Placeholder only; the real package is produced by this build."
    } > "$_dir/DEBIAN/control"
    if ! dpkg-deb --build "$_dir" "/tmp/stub-$$-$_pkg.deb" >/dev/null 2>&1; then
        warn "could not build stub for $_pkg"
    elif ! dpkg -i "/tmp/stub-$$-$_pkg.deb" >/dev/null 2>&1; then
        warn "could not install stub for $_pkg"
    fi
    rm -rf "$_dir" "/tmp/stub-$$-$_pkg.deb"
}

while IFS= read -r _bp; do
    [ -n "$_bp" ] || continue
    install_stub "$_bp"
done <<EOF
$(awk '/^Package:/{print $2}' "$control_file")
EOF

# --- (b) install the local-repo build-deps with apt-get ---
# Build-Depends / Build-Depends-Indep of the source stanza (first stanza),
# reduced to bare package names (drop version constraints, architecture and
# profile qualifiers, and the "native" keyword).
build_deps=$(awk '
    /^[ \t]*$/ { stanza++; next }
    stanza > 0 { next }
    /^Build-Depends(-Indep)?:/ {
        sub(/^Build-Depends(-Indep)?:[ \t]*/, "")
        printf "%s", $0
        inbd = 1
        next
    }
    inbd && /^[ \t]/ { sub(/^[ \t]+/, ""); printf "%s", $0; next }
    inbd          { inbd = 0 }
    END { print "" }
' "$control_file" 2>/dev/null \
    | tr ',' '\n' \
    | sed -e 's/[(].*$//' -e 's/\[.*\]//g' -e 's/[ \t].*$//' \
    | grep -v '^$' | grep -vx 'native' | sort -u)

if [ -n "$repo_path" ] && [ -n "$build_deps" ]; then
    # names of packages actually present in the local repository, plus the
    # virtual packages they provide (e.g. libpve-access-control, provided by
    # pve-access-control; pve-doc-generator, provided by pve-docs)
    local_names=$(awk '
        /^Package:/  { pkg = $2 }
        /^Provides:/ {
            sub(/^Provides:[ \t]*/, "")
            n = split($0, a, ",")
            for (i = 1; i <= n; i++) {
                sub(/[ \t(].*$/, "", a[i])
                if (a[i] != "") print a[i]
            }
        }
    ' "$repo_path/Packages" 2>/dev/null | sort -u)
    for dep in $build_deps; do
        # keep only names that are (or are provided by) local-repo packages
        case " $local_names " in
            *" $dep "*) ;;
            *) continue ;;
        esac
        if ! apt-get -y -q install "$dep" 2>/dev/null; then
            warn "skipping local build-dep $dep (not yet resolvable; will be built in a later pass)"
        fi
    done
fi

exit 0
