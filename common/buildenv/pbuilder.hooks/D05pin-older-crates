#!/bin/sh
# Keep Debian crate versions that the Proxmox packages were built against.
# In a sid chroot, trixie is added as an extra mirror for older crate
# versions (nix 0.29, base32 0.4). apt would otherwise pick the newer sid
# binary with the same name, which no longer provides the virtual package
# required by librust-proxmox-* dev packages.
set -eu
mkdir -p /etc/apt/preferences.d
cat > /etc/apt/preferences.d/proxmox-rust-crates <<'EOF'
Package: librust-base32-dev librust-nix-dev
Pin: release n=trixie
Pin-Priority: 1001
EOF
