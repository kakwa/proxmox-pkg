#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

override_dh_auto_test:
	# The test suite loads PVE::Storage, which unconditionally pulls in
	# PVE::Storage::RBDPlugin -> PVE::RADOS (the Ceph librados2-perl
	# bindings). Those bindings only exist in the Proxmox Ceph build and
	# are not available in stock Debian, so the suite cannot run in a
	# Debian build chroot. Skip it.
	true

override_dh_auto_install:
	# The install target loads the pvesm CLI (-> PVE::Storage ->
	# RBDPlugin -> PVE::RADOS) to generate completions and docs.
	# PVE::RADOS is provided by the Ceph librados2-perl package, which
	# is not in stock Debian. Drop a minimal stub into the source tree
	# just so the `use` resolves at build time. It is picked up via
	# the `perl -I..` invocations and is NOT part of the fixed install
	# list in PVE/Makefile, so it is never shipped in the package.
	printf 'package PVE::RADOS;\n# Build-time-only stub: the real module is provided by the\n# Ceph librados2-perl package (see Depends). Never installed.\nsub new { die "PVE::RADOS build-time stub: Ceph not available\\n" }\n1;\n' > PVE/RADOS.pm
	dh_auto_install

%:
	dh $@
